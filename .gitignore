__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.db-journal
# Written into base_station/ by /import/upload. A real GliderScore upload holds
# competitor data and is easy to commit by accident. [I-20]
gs_upload.mdb
*.mdb
venv/
.venv/
*.egg-info/
dist/
build/
.env
*.log
Knowledge_Base/

# Pilot-name announcement clips. Deliberately NOT in git: one per pilot per
# competition, so the set grows without bound, and they are recordings of real
# people's names. The fixed announcement vocabulary (Round/Group/Task/countdown)
# IS committed under frontend/data/audio — that set is static and bounded.
base_station/frontend/data/audio/ZZ*.wav

# Runtime state written by the running server. Untracked on purpose, but the Pi
# update flow does `git reset --hard`, so ignoring them keeps `git status` clean
# on a deployed unit instead of showing permanent drift.
base_station/audio_config.json
base_station/downloads/

# Generated by PyInstaller — tools/build_exe.ps1 deletes and regenerates it
F3KSync.spec

# Working notes / planning docs — kept local only, not pushed (see README for repo scope)
frontend_notes.md
SESSION_STATE.md
NEXT_SESSION_PROMPT.md
GLIDERSCORE.md
PROJECT_SPEC.md
PROJECT_PHASES.md
GUARDRAILS.md
