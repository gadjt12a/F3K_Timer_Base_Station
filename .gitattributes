# Scripts and configs in this repo are deployed to the Raspberry Pi. A CRLF
# working copy (core.autocrlf=true on Windows) makes bash fail with obscure
# "\r: command not found" errors after an scp, so pin them to LF regardless
# of platform.
*.sh  text eol=lf
*.py  text eol=lf
*.service text eol=lf
*.conf text eol=lf
# Git hooks have no extension and are executed by sh — a CRLF copy fails with
# "bad interpreter", which on Windows would silently disable the pre-commit check.
.githooks/* text eol=lf
